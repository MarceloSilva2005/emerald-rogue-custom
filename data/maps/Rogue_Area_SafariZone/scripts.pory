mapscripts Rogue_Area_SafariZone_MapScripts {}

script Rogue_Area_SafariZone_TalkSign
{
    lock

    msgbox(format("É uma placa com os Pokémon vistos recentemente na Safari Area!"))
    
    begindynamicmultichoice
    appenddynamicmultichoice("Ver Pokémon", 0)
    appenddynamicmultichoice("Dispensar Pokémon", 1)
    appenddynamicmultichoice("Sair", MULTI_B_PRESSED)

    message(format("O que você quer fazer?"))
    waitmessage
    enddynamicmultichoice(1, 0, 6, TRUE)

    switch(var(VAR_RESULT))
    {
        case 0:
            special(RogueSafari_CompactEmptyEntries)
            special(Special_SelectSafariMonInPokedex)
            waitstate

        case 1:
            msgbox(format("Tem certeza que quer dispensar todos os Pokémon atuais da Safari?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                special(RogueSafari_ResetAllRegularEntries)
                special(ReloadWarpSilent)
            }
    }

    release
}
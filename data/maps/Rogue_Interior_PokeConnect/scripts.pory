const VAR_STOP_TUTORIAL = VAR_TEMP_0

mapscripts Rogue_Interior_PokeConnect_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_PokeConnect_OnMapLoad
}

script Rogue_Interior_PokeConnect_OnMapLoad
{
    if(flag(FLAG_ROGUE_ASSISTANT_TUTORIAL))
    {
        setvar(VAR_STOP_TUTORIAL, 1)
    }
    else
    {
        setvar(VAR_STOP_TUTORIAL, 0)
    }
}

script Rogue_Interior_PokeConnect_TalkMultiplayer
{
    lock

    special(Rogue_IsMultiplayerActive)
    if(var(VAR_RESULT) == TRUE)
    {
        msgbox(format("Olá, {PLAYER}!\pEspero que esteja curtindo sua Multiplayer Adventure!"), MSGBOX_DEFAULT)
    
        special(Rogue_IsMultiplayerHost)
        if(var(VAR_RESULT) == TRUE)
        {
            msgbox(format("Quer parar de ser Host?"), MSGBOX_YESNO)
        }
        else
        {
            msgbox(format("Quer desconectar e voltar para casa?"), MSGBOX_YESNO)
        }

        if(var(VAR_RESULT) == TRUE)
        {
            special(Rogue_CloseMultiplayer)
            msgbox(format("Pronto!\pEspero que tenha curtido suas Multiplayer Adventures!"), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("Olá, {PLAYER}!\pPosso configurar Multiplayer Adventures para você e um amigo!"), MSGBOX_DEFAULT)

        msgbox(format("{COLOR RED}AVISO!\n{COLOR DARK_GRAY}Este recurso ainda está em Alpha.\pComo segue em desenvolvimento, alguns recursos podem falhar ou estar ausentes.\pSalve com frequência e mantenha backups do save enquanto usar este recurso."))

        call(Rogue_Common_WaitForRogueAssistant)

        if(var(VAR_RESULT) == TRUE)
        {
            call(Common_EventScript_SaveGame)
            if(var(VAR_RESULT) == YES)
            {
                message(format("Escolham quem será o Group Host.\pOs outros jogadores devem escolher Join Group."))
                waitmessage

                multichoice(16, 6, MULTI_LINK_HOST_JOIN, FALSE)

                switch(var(VAR_RESULT))
                {
                    case 0: // Join
                        message(format("Configure pelo Rogue Assistant agora\n… … B Button: Cancel"))
                        waitmessage

                        special(Rogue_JoinMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("Tudo pronto!\nDivirtam-se nas Aventuras!"))
                        }

                    case 1: // Host
                        message(format("Configure pelo Rogue Assistant agora\n… … B Button: Cancel"))
                        waitmessage

                        special(Rogue_HostMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("Tudo pronto!\nAgora um amigo pode entrar nas suas Aventuras!"))
                        }

                    case 2: // Exit
                        setvar(VAR_RESULT, FALSE)

                }
            }
        }

        if(var(VAR_RESULT) == FALSE)
        {
            special(Rogue_GetLastMultiplayerConnectError)
            
            switch(var(VAR_RESULT))
            {
                case 1: // CONN_ERR_WRONG_GAME_FLAVOUR
                    poryswitch(ROGUE_VERSION)
                    {
                        ROGUE_VERSION_VANILLA
                        {
                            msgbox(format("Desculpe.\nEsse Player usa Vanilla diferente da sua."))
                        }
                        ROGUE_VERSION_EXPANSION
                        {
                            msgbox(format("Desculpe.\nEsse Player usa EX diferente da sua."))
                        }
                    }

                case 2: // CONN_ERR_WRONG_SAVE_VERSION
                    msgbox(format("Desculpe.\nEsse Player usa outra Update Version."))

                case 3: // CONN_ERR_WRONG_REVISED_MODE
                    msgbox(format("Desculpe.\nOs ajustes de Revision Mode de vocês ficam incompatíveis no Config Lab."))

                default: // CONN_ERR_NONE
                    msgbox(format("Se mudar de ideia, fale comigo novamente."))

            }
        }
    }

    release
}

script Rogue_Interior_PokeConnect_TalkNurseBox
{
    lock

    msgbox(format("Olá, {PLAYER}!"))

    setvar(VAR_RESULT, 1)

    while(var(VAR_RESULT) == 1)
    {
        message(format("Quer acessar o Extended Pokémon Storage?"))
        waitmessage

        multichoice(20, 6, MULTI_YESNOINFO, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // Yes
                call(Rogue_Interior_PokeConnect_ConnectHomeBox)
                setvar(VAR_RESULT, 0)

            case 1: // No
            case MULTI_B_PRESSED:
                setvar(VAR_RESULT, 0)

            case 2: // Info
                msgbox(format("Ao conectar ao Rogue Assistant, você acessa um Pokémon Storage ampliado, parecido com Pokémon Home, com espaço para muito mais Pokémon!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, 1)
        }
    }

    msgbox(format("Até mais!"))
    release
}

script Rogue_Interior_PokeConnect_ConnectHomeBox
{
    call(Rogue_Common_WaitForRogueAssistant)
    
    if(var(VAR_RESULT) == TRUE)
    {
        call(Common_EventScript_SaveGame)
        if(var(VAR_RESULT) == YES)
        {
            special(Special_ViewAssistantBox)
            waitstate

            call(Common_EventScript_ForceSaveGame)
        }
    }
}

script Rogue_Interior_PokeConnect_Tutorial
{
    setflag(FLAG_ROGUE_ASSISTANT_TUTORIAL)
    setvar(VAR_STOP_TUTORIAL, 1)

    lock
    msgbox(format("Este prédio dá acesso a recursos externos como Extended Storage e Multiplayer.\pNo momento, eles funcionam apenas no mGBA em Windows PC.\pPara usar esses recursos, baixe o Rogue Assistant e conecte ao emulador.\pDownload oficial:\n{COLOR BLUE}https://rogue.assist.pokabbie.com\p{COLOR RED}Evite outros links para reduzir risco de malware!"))
    release
}
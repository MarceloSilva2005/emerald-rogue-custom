mapscripts Rogue_Interior_School_MapScripts {}


script Rogue_Interior_School_ShowSetRecommendation
{
    lock
    faceplayer
    
    msgbox(format("Ei, você parece ser Trainer.\pPosso sugerir como eu montaria seus Pokémon se fossem meus."))

    setvar(VAR_0x8004, 0)

    while(var(VAR_0x8004) != PARTY_SIZE)
    {
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        showplayerpartypic(VAR_0x8004, 2, 2)
        playmoncry(VAR_RESULT, CRY_MODE_NORMAL)

        callnative(ScriptMenu_DisplayRecommendedMonSet)
        messageinstant("{DPAD_LEFTRIGHT} Cycle Party Pokémon\n{A_BUTTON} {B_BUTTON} Exit")
        waitstate
        hidemonpic
    }

    msgbox(format("Se precisar de mais ajuda, é só pedir!"))

    release
}

script Rogue_Interior_School_TalkRunningKid0
{
    lockall
    faceplayer

    msgbox(format("Estou apertando B duas vezes para correr muito rápido!\pIsso ajuda até a fugir de Wild Pokémon mais depressa!\pRápido demais!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningKid1
{
    lockall
    faceplayer

    msgbox(format("Volta aqui!\nB B B B B B!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningStatsHint
{
    lockall
    faceplayer

    msgbox(format("Arrgghhh!\pMontar EV spreads perfeitos ficou bem mais difícil!\pAntes eu treinava em Wild Pokémon, mas agora os EVs chegam depois de Trainer battles.\pO spread depende da Nature.\pPor isso vale escolher uma boa Nature cedo!\pPelo menos dá para ver EVs e IVs a qualquer momento.\pAperte {A_BUTTON} no Stats Summary do Pokémon."))

    releaseall
}

script Rogue_Interior_School_TalkPokeblock
{
    lockall
    faceplayer

    msgbox(format("Meus Pokémon adoram {POKEBLOCK}!\pEm uma Route, espalhe {POKEBLOCK} para tentar atrair novos tipos de Pokémon."))

    releaseall
}

script Rogue_Interior_School_TalkTeacher
{
    lockall
    faceplayer

    msgbox(format("Ah! Bem-vindo!\pTenho ensinado meus alunos tudo o que sei sobre Aventuras!\pEles ficam felizes em dividir esse conhecimento com você."))

    releaseall
}

script Rogue_Interior_School_TalkRouteHint
{
    lockall
    faceplayer


    msgbox(format("Tenho estudado todos os tipos de encontros!\pAinda falta aprender bastante.\pMas posso contar o que descobri até agora!"))

    setvar(VAR_RESULT, 0)

    while(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Route Difficulty", 0)
        appenddynamicmultichoice("Route Types", 1)
        appenddynamicmultichoice("Habitats Treinados", 2)
        appenddynamicmultichoice("Honey Trees", 3)

        message(format("Sobre o que você quer saber?"))
        waitmessage
        enddynamicmultichoice(20, 2, 5, TRUE)
        
        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("AS ROUTES!\nCada Route traz 2 dicas.\pA primeira é a Difficulty.\nA segunda é o Type.\pExistem 3 Difficulties: Calm, Average e Tough.\pCalm traz mais Wild Pokémon, mas menos Items e Trainers.\pTough traz menos Wild Pokémon, porém mais Items e Trainers, com itens geralmente melhores.\pOs Trainers dessas Routes costumam ser bem mais fortes.\pAverage fica no meio-termo e costuma ser uma escolha segura."))

            case 1:
                msgbox(format("AS ROUTES!\nCada Route traz uma dica de Type.\pCada palavra representa um Type: Warm indica Fire, Confusing indica Psychic e assim por diante.\pA dica garante pelo menos 1 Pokémon daquele Type na Route.\pEm Routes Calm, costuma aparecer mais de um Pokémon compatível com a dica."))

            case 2:
                msgbox(format("ESSES ENCONTROS!\nOs Pokémon daqui parecem já treinados para batalha!\pCostumam ter boa Nature, Ability e moves, além de pelo menos 1 IV perfeito.\pComo esses Pokémon ficam fortes, vivem sozinhos e você só descobre a espécie ao entrar.\pPode ser um Charizard!\nOu um Magikarp…\pÉ sempre uma aposta."))

            case 3:
                msgbox(format("HONEY TREES!\nEles ficam bem mais úteis com {POKEBLOCK}.\pWild Pokémon costumam parar ali para comer e descansar, e espalhar {POKEBLOCK} aumenta muito a chance de encontrar um Pokémon na próxima visita.\pSe eu quisesse Bulbasaur, poderia espalhar Grass e Poison {POKEBLOCK}.\pTalvez viesse Bulbasaur… ou Oddish…\nou Bellsprout.\pQuanto mais rara a mistura de Types, melhor fica a chance de acertar o alvo."))

            case MULTI_B_PRESSED:
                msgbox(format("Certo…\nTenho muito mais para contar quando quiser!"))
        }
    }

    releaseall
}
const FLAG_HIDE_BIRCH = FLAG_TEMP_1
const FLAG_HIDE_RUIN_MANIAC = FLAG_TEMP_2

const VAR_FRAME_STATE = VAR_TEMP_0

const OBJ_EVENT_BIRCH = 1
const OBJ_EVENT_ASSISTANT = 2
const OBJ_EVENT_RUIN_MANIAC = 3

mapscripts Rogue_Interior_ProfLab_MapScripts
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_ProfLab_OnMapLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_FRAME_STATE, 0: Rogue_Interior_ProfLab_FrameState0
    ]
}

script Rogue_Interior_ProfLab_OnMapLoad
{
    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_EXPLORE)
    {
        clearflag(FLAG_HIDE_RUIN_MANIAC)
    }
    else
    {
        setflag(FLAG_HIDE_RUIN_MANIAC)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_CATCH_MON)
    {
        setflag(FLAG_HIDE_BIRCH)
    }
    else
    {
        clearflag(FLAG_HIDE_BIRCH)
    }

    if(var(VAR_ROGUE_INTRO_STATE) == ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        setvar(VAR_FRAME_STATE, 0)
    }
    else
    {
        setvar(VAR_FRAME_STATE, 1)
    }
}

script Rogue_Interior_ProfLab_FrameState0
{
    lock

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    msgbox(format("ELM: Pronto!\pTenho que admitir, sua técnica de captura me impressionou!\pSeria difícil escolher alguém melhor para explorar por {POKEMON_HUB}!"))
    msgbox(format("Agora, {PLAYER}.\nQuer que eu explique como funcionam as Aventuras?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }
    else
    {
        msgbox(format("Sua memória está melhor do que eu esperava!\nFuhahaha!"))
    }

    msgbox(format("Antes de ir, leve isto!"))
    giveitem(ITEM_POKE_BALL, 10)
    giveitem(ITEM_POTION, 5)

    msgbox(format("E por fim, sua própria Pokédex!"))
    
    if(flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox(format("Ah, parece que Pokabbie já te deu uma Pokédex!\pNesse caso, esta aqui fica comigo!\nFuhahaha!"))
    }
    else
    {
        callnative(Rogue_PushPopup_UnlockPokedex)
        call(Rogue_Common_DisplayPopups)
        setflag(FLAG_SYS_POKEDEX_GET)
    }
    setflag(FLAG_SYS_POKEMON_GET)

    msgbox(format("Essa Pokédex recebeu melhorias!\pEla mostra stats, moves, formas de evoluir e muito mais!"))
    msgbox(format("Agora está tudo pronto!\pBoa sorte, {PLAYER}!"))
    closemessage

    addvar(VAR_ROGUE_INTRO_STATE, 1)
    addvar(VAR_FRAME_STATE, 1)

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant0)
    waitmovement(0)

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)
    msgbox(format("Oi, {PLAYER}!\pSeu {STR_VAR_1} parece gostar de caminhar fora da Poké Ball.\pQuer deixar {STR_VAR_1} te seguindo?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("{STR_VAR_1} parece muito feliz!"))
    }
    else
    {
        clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
        special(Rogue_SetupFollowParterMonObjectEvent)

        msgbox(format("Ah…\nSe mudar de ideia, fale comigo."))
    }
    closemessage

    applymovement(OBJ_EVENT_ASSISTANT, IntroAssistant1)
    waitmovement(0)


    release
}

movement IntroAssistant0
{
    walk_left * 4
    walk_up * 4
}

movement IntroAssistant1
{
    walk_right
    face_left
}

script Rogue_Interior_ProfLab_TalkBirch
{
    lock
    faceplayer
    msgbox(format("ELM: Oi, {PLAYER}!\pQuer que eu explique como funcionam as Aventuras?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        call(Rogue_Interior_ProfLab_TalkBirch_AdventureExplain)
    }


    release
}

script Rogue_Interior_ProfLab_TalkAssistant
{
    lock
    faceplayer

    if(var(VAR_ROGUE_INTRO_STATE) < ROGUE_INTRO_STATE_REPORT_TO_PROF)
    {
        msgbox(format("Oi, {PLAYER}!\pEspero que esteja bem!\nOuvi falar da pancada na cabeça."))
    }
    else
    {
        setvar(VAR_0x8004, 0)
        special(BufferMonNickname)
        if(flag(FLAG_SYS_SHOW_POKE_FOLLOWER))
        {
            msgbox(format("Oi, {PLAYER}!\pQuer colocar {STR_VAR_1} de volta na Poké Ball?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                clearflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        else
        {
            msgbox(format("Oi, {PLAYER}!\pQuer deixar {STR_VAR_1} te seguindo?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_SYS_SHOW_POKE_FOLLOWER)
            }
        }
        special(Rogue_SetupFollowParterMonObjectEvent)
    }

    release
}

script Rogue_Interior_ProfLab_TalkBirch_AdventureExplain
{
    msgbox(format("Como deve lembrar, o mundo fora de {POKEMON_HUB} ficou bem estranho.\pAs Routes mudam e podem surgir em uma ordem diferente a cada Aventura."))
    msgbox(format("Ao iniciar uma Aventura, o nível dos seus Pokémon é reajustado.\pEles continuam com os mesmos moves."))
    msgbox(format("Sua Bag tem uma propriedade estranha.\pAo sair para uma Aventura, o estado dela fica registrado!\pAo voltar para {POKEMON_HUB}, ela retorna exatamente ao estado de antes da partida.\pPor exemplo: uma Super Potion encontrada na Aventura desaparece ao voltar.\pJá uma Poké Ball que você levou e gastou reaparece na Bag quando retorna."))
    msgbox(format("E claro, os Trainers continuam loucos por batalhas!\pTenha cuidado e treine bem seus Pokémon!"))
    msgbox(format("É tudo muito estranho!\pAinda estamos pesquisando para entender o que está acontecendo!"))
}

script Rogue_Interior_ProfLab_TriggerIntro0
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro0)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro1
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro1)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntro2
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerIntro2)
    waitmovement(0)
    call(Rogue_Interior_ProfLab_TriggerIntroInternal)
    release
}

script Rogue_Interior_ProfLab_TriggerIntroInternal
{
    msgbox(format("ELM: Oi, {PLAYER}!\pParece que sua memória já voltou um pouco!\pAgora que {POKEMON_HUB} está estabelecida, precisamos de alguém para explorar Aventuras e reunir recursos.\pCom isso poderemos construir e expandir a vila.\pÉ aí que você entra, {PLAYER}!\pMas para isso vai precisar de um Pokémon Partner…"))

    playbgm(MUS_NONE, FALSE)
    msgbox(format("PROFEEEEESSOR!"))
    closemessage

    setobjectxy(OBJ_EVENT_RUIN_MANIAC, 4, 11)
    //showobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    playbgm(MUS_HELP, FALSE)
    
    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro0)
    waitmovement(0)

    msgbox(format("P- P- Pokémon vieram invadir!"))

    applymovement(OBJ_EVENT_BIRCH, BirchIntro0)
    waitmovement(0)

    msgbox(format("ELM: Como assim!?\pIsso parece sério, {PLAYER}.\pMelhor irmos ajudar!"))
    closemessage

    applymovement(OBJ_EVENT_RUIN_MANIAC, RuinManiacIntro1)
    applymovement(OBJ_EVENT_BIRCH, BirchIntro1)
    waitmovement(0)

    hideobjectat(OBJ_EVENT_RUIN_MANIAC, MAP_ROGUE_INTERIOR_PROF_LAB)
    hideobjectat(OBJ_EVENT_BIRCH, MAP_ROGUE_INTERIOR_PROF_LAB)
    setflag(FLAG_HIDE_RUIN_MANIAC)
    setflag(FLAG_HIDE_BIRCH)

    addvar(VAR_ROGUE_INTRO_STATE, 1)
}

movement PlayerIntro0
{
    walk_right
    walk_up * 2
}

movement PlayerIntro1
{
    walk_up * 2
}

movement PlayerIntro2
{
    walk_left
    walk_up * 2
}

movement RuinManiacIntro0
{
    walk_fast_up * 6
}

movement RuinManiacIntro1
{
    walk_fast_down * 10
}

movement BirchIntro0
{
    emote_exclamation_mark
}

movement BirchIntro1
{
    walk_fast_right
    walk_fast_down * 10
}
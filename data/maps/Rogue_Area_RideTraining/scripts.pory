script Rogue_Area_RideTraining_GiveGoldWhistle
{
    showmoneybox(0, 0)

    msgbox(format("Posso te dar um Gold Whistle por ¥15000. Quer comprar?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        checkconstantmoney(15000)
        if(var(VAR_RESULT) == YES)
        {
            removeconstantmoney(15000)
            updatemoneybox

            playse(SE_SHOP)
            waitse

            msgbox(format("Muito obrigado, {PLAYER}!"))
            msgbox(format("Aqui está!"))

            hidemoneybox
            giveitem(ITEM_GOLD_RIDING_WHISTLE)

            msgbox(format("O Gold Whistle também pode chamar meu amigo sem depender da sua equipe.\pPode sair!"))

            poryswitch(ROGUE_VERSION)
            {
                ROGUE_VERSION_VANILLA
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_DITTO, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("Fale com Ditto para ele copiar um dos seus Pokémon.\pDepois disso, mesmo fora da equipe, você pode chamar essa forma com o Gold Whistle."))

                    message(format("{COLOR GREEN}{SHADOW LIGHT_GREEN}{PLAYER} aprendeu a chamar Ditto!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
                ROGUE_VERSION_EXPANSION
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_ZORUA_HISUIAN, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("Fale com Zorua para ele copiar um dos seus Pokémon.\pDepois disso, mesmo fora da equipe, você pode chamar essa forma com o Gold Whistle."))

                    message(format("{COLOR GREEN}{SHADOW LIGHT_GREEN}{PLAYER} aprendeu a chamar Zorua!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
            }
        }
        else
        {
            msgbox(format("Ah… parece que falta dinheiro no momento."))
            hidemoneybox
        }
    }
    else
    {
        hidemoneybox
    }
}


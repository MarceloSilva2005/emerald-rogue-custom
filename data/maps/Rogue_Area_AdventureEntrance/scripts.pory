script Rogue_Area_AdventureEntrance_SpeakRuinManiac
{
    lock
    msgbox(format("Hmm…\nEsses barulhos parecem problema…"))
    release
}

script Rogue_Area_AdventureEntrance_TriggerRuinManiacEast
{
    lock

    applymovement(OBJ_EVENT_RUIN_MANIAC, Common_Movement_FacePlayer)
    waitmovement(0)

    msgbox(format("Espere!\pOuvi uns barulhos estranhos vindo dali!\pFique para trás e deixe que eu vá primeiro!\p… … …"))
    
    applymovement(OBJ_EVENT_RUIN_MANIAC, Common_Movement_FaceRight)
    waitmovement(0)
    msgbox(format("Só me dê um instante para criar coragem…"))
    closemessage

    applymovement(OBJ_EVENT_ID_PLAYER, WalkLeft)
    waitmovement(0)
    release
}


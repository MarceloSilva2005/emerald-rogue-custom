const VAR_BERRY_BUFF_AMOUNT = VAR_0x8005

const BERRY_BUFF_FRIEND = 0
const BERRY_BUFF_HP = 1
const BERRY_BUFF_ATK = 2
const BERRY_BUFF_DEF = 3
const BERRY_BUFF_SPD = 4
const BERRY_BUFF_SPATK = 5
const BERRY_BUFF_SPDEF = 6
const BERRY_BUFF_WEAKEN = 7

mapscripts Rogue_Hub_Bakery_MapScripts {}



script RogueHub_Bakery_SpeakChef_ApplyTreat
{
    special(Rogue_ApplyBerryTreat)

    if(var(VAR_RESULT) == YES)
    {
        playse(SE_SHOP)
        waitse

        updatemoneybox

        msgbox(format("Saindo!"))

        fadescreen(FADE_TO_BLACK)
        playfanfare(MUS_HEAL)
        waitfanfare
        fadescreen(FADE_FROM_BLACK)

        special(BufferMonNickname)
        special(Rogue_CheckBerryTreat)
        switch(var(VAR_RESULT))
        {
            case BERRY_BUFF_FRIEND:
                msgbox(format("{STR_VAR_1} ficou mais amigável."))

            case BERRY_BUFF_HP:
                msgbox(format("O HP de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_ATK:
                msgbox(format("O Atk de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_DEF:
                msgbox(format("A Def de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_SPATK:
                msgbox(format("O SpAtk de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_SPDEF:
                msgbox(format("O SpDef de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_SPD:
                msgbox(format("A Speed de {STR_VAR_1} melhorou."))

            case BERRY_BUFF_WEAKEN:
                msgbox(format("{STR_VAR_1} ficou mais fraco."))
        }

        msgbox(format("Espero que você e {STR_VAR_1} tenham gostado!\pAté a próxima!"))
        setvar(VAR_RESULT, YES)
    }
    else
    {
        special(BufferMonNickname)
        msgbox(format("Ah.\p{STR_VAR_1} parece cheio demais para comer isto."))
    }
}

script RogueHub_Bakery_SpeakChefSlice
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("Bem-vindo à Bakery!\nSou especialista em Cupcakes que aumentam um pouco os stats dos Pokémon.\pQuer um Cupcake para dividir com {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Que tipo de Berry devo usar?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("Para isso, preciso de 3 Berries.\pO custo é ¥500."))

            checkitem(VAR_ITEM_ID, 3)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("Ah.\nParece que faltam Berries."))
            }
            else
            {
                checkmoney(500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("Ah.\nParece que falta dinheiro."))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("Posso pegar os ingredientes e começar a preparar?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 1)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(500)
                    removeitem(VAR_ITEM_ID, 3)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Volte quando quiser, caso mude de ideia."))
    }

    release
}

script RogueHub_Bakery_SpeakChefFull
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("Bem-vindo à Bakery!\nSou especialista em Pies que aumentam os stats dos Pokémon.\pQuer uma Pie para dividir com {STR_VAR_1}?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("Que tipo de Berry devo usar?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("Para isso, preciso de 15 Berries.\pO custo é ¥2500."))

            checkitem(VAR_ITEM_ID, 15)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("Ah.\nParece que faltam Berries."))
            }
            else
            {
                checkmoney(2500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("Ah.\nParece que falta dinheiro."))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("Posso pegar os ingredientes e começar a preparar?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 5)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(2500)
                    removeitem(VAR_ITEM_ID, 15)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("Volte quando quiser, caso mude de ideia."))
    }

    release
}

script RogueHub_Bakery_SpeakBerryCheck
{
    lock
    faceplayer

    msgbox(format("Berries diferentes afetam stats diferentes depois de assadas."))
    msgbox(format("Quer saber qual stat cada Berry altera?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) != 0)
        {
            special(Rogue_CheckBerryTreat)
            bufferitemname(STR_VAR_1, VAR_ITEM_ID)
            switch(var(VAR_RESULT))
            {
                case BERRY_BUFF_FRIEND:
                    msgbox(format("{STR_VAR_1} aumenta a amizade de um Pokémon."))

                case BERRY_BUFF_HP:
                    msgbox(format("{STR_VAR_1} melhora o HP de um Pokémon."))

                case BERRY_BUFF_ATK:
                    msgbox(format("{STR_VAR_1} melhora o Atk de um Pokémon."))

                case BERRY_BUFF_DEF:
                    msgbox(format("{STR_VAR_1} melhora a Def de um Pokémon."))

                case BERRY_BUFF_SPATK:
                    msgbox(format("{STR_VAR_1} melhora o SpAtk de um Pokémon."))

                case BERRY_BUFF_SPDEF:
                    msgbox(format("{STR_VAR_1} melhora o SpDef de um Pokémon."))

                case BERRY_BUFF_SPD:
                    msgbox(format("{STR_VAR_1} melhora a Speed de um Pokémon."))

                case BERRY_BUFF_WEAKEN:
                    msgbox(format("{STR_VAR_1} deixa um Pokémon mais fraco."))
            }
        }
    }

    release
}

script RogueHub_Bakery_SpeakIVEVInspector
{
    lock
    faceplayer

    msgbox(format("Sabia que dá para ver IVs e EVs apertando A no Summary do Pokémon?\pTecnologia moderna é ótima, hein!"))

    release
}

